# Maintainer: WastedLookz <231484447+WastedLookz@users.noreply.github.com>
pkgname=fastviz
pkgver=0.5.0
pkgrel=1
pkgdesc='Fast, minimal photo and video browser for GNOME/Wayland'
arch=('x86_64')
url='https://github.com/WastedLookz/FastViz'
license=('GPL-3.0-or-later')
# The libraries the binary links directly.
depends=(
  'cairo'
  'ffmpeg'
  'glib2'
  'glibc'
  'graphene'
  'gtk4'
  'libadwaita'
  'libgcc'
  'libglvnd'
  'libheif'
  'libjpeg-turbo'
  'libraw'
  'mpv'
  'pango'
)
# clang: bindgen for the FFmpeg bindings; python: the crates' license notices.
makedepends=('cargo' 'clang' 'python')
optdepends=(
  'gvfs: drives and phones in the folder tree, Undo after Move to Trash'
  'udisks2: mounting drives from the folder tree'
)
# The C wrapper around LibRaw is linked by rustc, which doesn't take part in
# GCC's link-time optimization.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6133475e55a8420040f7b8f17af38c489c4387c3f4cc7871f3ac6e642b0129b2')

prepare() {
  cd "FastViz-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "FastViz-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  # The Rust crates compiled into the binary, with their license texts.
  CARGO_NET_OFFLINE=true python tools/third-party-licenses.py target/THIRD-PARTY-LICENSES.txt
}

check() {
  cd "FastViz-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "FastViz-$pkgver"
  local id=io.github.wastedlookz.FastViz
  install -Dm755 target/release/fastviz -t "$pkgdir/usr/bin/"
  install -Dm644 "data/$id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "data/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 "data/icons/$id.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 target/THIRD-PARTY-LICENSES.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
