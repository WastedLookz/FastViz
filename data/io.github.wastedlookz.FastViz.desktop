[Desktop Entry]
Type=Application
Name=FastViz
GenericName=Photo and Video Browser
Comment=Browse photos and videos quickly
Exec=fastviz %U
Icon=io.github.wastedlookz.FastViz
Terminal=false
Categories=Graphics;Viewer;Photography;GTK;
Keywords=photo;image;video;viewer;browser;gallery;slideshow;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/heif;image/heic;image/avif;video/mp4;video/x-m4v;video/quicktime;video/3gpp;video/3gpp2;video/x-matroska;video/webm;video/vnd.avi;video/x-msvideo;video/x-ms-wmv;application/vnd.ms-asf;video/x-flv;video/mpeg;video/mp2t;video/ogg;video/dv;application/mxf;
StartupNotify=true
